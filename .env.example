# =======================================================
# Pasa La Peli - Variables de entorno del stack (EC2)
# Copia este archivo como `.env` en el directorio del repo
# orquestador (pasalapeli-database) y ajusta los valores.
# NUNCA subir el `.env` real a GitHub (esta en .gitignore).
# =======================================================

# --- MySQL (topologia 3 EC2: apunta a la BDD externa en EC2-BDD) ---
# SPRING_DATASOURCE_URL=jdbc:mysql://<IP_BDD>:3306/pasalapeli_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=pasalapeli_db
SPRING_DATASOURCE_USERNAME=pasalapeli
SPRING_DATASOURCE_PASSWORD=pasalapeli123

# --- Microsoft Entra ID (Azure AD) ---
# FAIL-CLOSED: en produccion DEBE ser true (el default del compose es true).
# Solo poner false en desarrollo local / demos sin suscripcion Azure.
AZURE_AUTH_ENABLED=true
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=common
AZURE_APP_ID_URI=api://00000000-0000-0000-0000-000000000000
# En produccion (AZURE_AUTH_ENABLED=true) descomentar y reemplazar {tenant-id}:
#AZURE_AD_ISSUER_URI=https://login.microsoftonline.com/{tenant-id}/v2.0
#AZURE_AD_JWK_SET_URI=https://login.microsoftonline.com/{tenant-id}/discovery/v2.0/keys

# --- Token interno de servicio (movie-service /descontar|/reponer) ---
# Compartido solo entre movie-service y ticket-service (red interna del compose).
# En produccion: generar un valor aleatorio y guardarlo como secret INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=dev-internal-token

# --- Dominio publico del frontend (debe ser HTTPS para Azure AD) ---
APP_BASE_URL=https://localhost
CORS_ALLOWED_ORIGINS=*

# --- Topologia 3 EC2: proxy /api del nginx en EC2-WEB -> EC2-APPS ---
# IP PRIVADA de EC2-APPS (la IP publica no funciona por hairpin NAT).
# El deploy del frontend la toma de la Variable de GitHub EC2_APPS_HOST
# (repo pasalapeli-frontend > Settings > Actions > Variables) via
# deploy.yml -> bootstrap-web.sh; este archivo en la EC2 se reescribe
# ahi. NO editar a mano: cambiar la Variable en GitHub.
# EC2_APPS_HOST=10.0.25.197

# --- Mensajeria asincrona (AWS SNS/SQS) ---
# Generados por scripts/setup-messaging.sh (idempotente). Los servicios usan
# la cadena de credenciales por defecto (IMDS + LabRole en EC2-APPS); no
# guardar claves AWS en este archivo.
AWS_REGION=us-east-1
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:513346712452:pasalapeli-events
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/513346712452/pasalapeli-notificaciones
# SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/513346712452/pasalapeli-notificaciones-dlq

# --- Almacenamiento de portadas (local en EC2-APPS) ---
# Directorio dentro del contenedor movie-service (montado en el volumen movie-uploads).
# LOCAL_UPLOAD_DIR=./uploads/peliculas