# =======================================================
# Pasa La Peli - Variables de entorno del stack (EC2)
# Copia este archivo como `.env` en el directorio del repo
# orquestador (pasalapeli-database) y ajusta los valores.
# NUNCA subir el `.env` real a GitHub (esta en .gitignore).
# =======================================================

# --- MySQL (topologia 3 EC2: apunta a la BDD externa en EC2-BDD) ---
# SPRING_DATASOURCE_URL=jdbc:mysql://<IP_BDD>:3306/pasalapeli_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=pasalapeli_db
SPRING_DATASOURCE_USERNAME=pasalapeli
SPRING_DATASOURCE_PASSWORD=pasalapeli123

# --- Microsoft Entra ID (Azure AD) ---
# Dejar en false para desarrollo local / demos sin suscripcion Azure.
AZURE_AUTH_ENABLED=false
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=common
AZURE_APP_ID_URI=api://00000000-0000-0000-0000-000000000000
# En produccion (AZURE_AUTH_ENABLED=true) descomentar y reemplazar {tenant-id}:
#AZURE_AD_ISSUER_URI=https://login.microsoftonline.com/{tenant-id}/v2.0
#AZURE_AD_JWK_SET_URI=https://login.microsoftonline.com/{tenant-id}/discovery/v2.0/keys

# --- Dominio publico del frontend (debe ser HTTPS para Azure AD) ---
APP_BASE_URL=https://localhost
CORS_ALLOWED_ORIGINS=*

# --- Amazon S3 (portadas) ---
AWS_S3_ENABLED=false
AWS_S3_BUCKET=pasalapeli-portadas
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=